# Copy this file to .env.local and fill in the real values.
# Supabase: Dashboard -> Project Settings -> API
# On Vercel: add these 3 vars in Project -> Settings -> Environment Variables (do NOT commit real values).

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon public key (Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# service_role key — SECRET, server-side only (Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Zoho CRM function REST endpoint (Setup > Functions > REST API, API Key auth).
# The URL carries a zapikey, so it is read server-side only by
# pages/api/scorecard.js and never reaches the browser.
# On Vercel: add this in Project -> Settings -> Environment Variables.
ZOHO_FUNCTION_URL=https://www.zohoapis.in/crm/v7/functions/<name>/actions/execute?auth_type=apikey&zapikey=<your-zapikey>
